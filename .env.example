# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL database URL (only needed if overriding the default localhost)
# DB_URL=jdbc:postgresql://localhost:5432/coder_editor

# PostgreSQL username (default: postgres)
DB_USER=postgres

# PostgreSQL password — REQUIRED, change this!
DB_PASSWORD=your_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Keep this secret!
JWT_SECRET=change-me-to-something-random-and-long-32chars

# Token expiry in milliseconds (default: 24 hours)
# JWT_EXPIRATION_MS=86400000

# ── AI (Gemini) ───────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default model
# GEMINI_MODEL=gemini-2.0-flash

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Server port ───────────────────────────────────────────────────────────────
# PORT=8080
